{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:minimax:plugin:app:v1",
  "title": "MiniMax Plugin App Reference V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "provider"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9_-]+(?![\\s\\S])"
    }
  }
}
