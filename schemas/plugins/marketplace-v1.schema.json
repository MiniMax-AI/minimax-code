{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:minimax:plugin:marketplace:v1",
  "title": "MiniMax Plugin Marketplace V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "plugins"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "deliveryTargets"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*(?![\\s\\S])"
          },
          "path": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^plugins/[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*(?![\\s\\S])"
          },
          "deliveryTargets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "desktop",
                "cloud"
              ]
            }
          },
          "installationPolicy": {
            "description": "Catalog-scoped installation ownership; omitted entries are USER_MANAGED.",
            "default": "USER_MANAGED",
            "enum": [
              "USER_MANAGED",
              "DEFAULT_INSTALLED_UNREMOVABLE"
            ]
          }
        }
      }
    }
  }
}
