{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:minimax:plugin:host-binding:v1",
  "title": "MiniMax Official Plugin Host Binding V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bindingId",
    "logicalToolName",
    "hostCapability",
    "requiredSkills",
    "allowedSurfaces"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "bindingId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*(?![\\s\\S])"
    },
    "logicalToolName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*(?![\\s\\S])"
    },
    "hostCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*(?![\\s\\S])"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "requiredSkills": {
      "description": "Exact names of declared Skills. Binding V1 retains the Desktop reader lowercase identifier restriction; ordinary Skill names have a wider portable-path alphabet.",
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*(?![\\s\\S])"
      }
    },
    "allowedSurfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["interactive"]
      }
    }
  }
}
